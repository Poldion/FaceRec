# Nach ~/facerec/facerec.env kopieren und ausfuellen (chmod 600 - enthaelt den HA-Schluessel)

# Home Assistant: von dort holt der Dienst das Klingelbild (Entitaet image.xxx oder camera.xxx).
# Langlebiges Zugriffstoken: HA -> Profil -> Sicherheit -> "Langlebige Zugriffstoken".
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Optional: Schluessel fuer API + Oberflaeche. Leer = ohne Anmeldung (nur im LAN betreiben!).
# Wenn gesetzt, braucht rest_command in HA den Kopf "Authorization: Bearer <Schluessel>".
FACEREC_TOKEN=

# Ab welcher Aehnlichkeit ein Gesicht als erkannt gilt / eine Person vorgeschlagen wird
# (buffalo_l, Kosinus; gleiche Person meist 0,4-0,8, verschiedene 0-0,3)
FACEREC_MATCH=0.32
FACEREC_SUGGEST=0.28
# Sprache der Ansage / des Push-Satzes: de ("Anna steht vor der Tür.") oder en ("Anna is at the door.")
FACEREC_LANG=de

# Stream-Scan: eigene MJPEG-Adressen je Kamera-Entitaet (sonst ueber Home Assistant), z.B. ESP32-CAM
#FACEREC_STREAM_URLS=camera.flur=http://192.168.1.50:8080/

# Nur ROCm-Variante: GPU-Gruppen des Hosts (getent group render video)
#RENDER_GID=992
#VIDEO_GID=44
